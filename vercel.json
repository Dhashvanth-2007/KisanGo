{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{api,server,public,node_modules/sql.js/dist}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
